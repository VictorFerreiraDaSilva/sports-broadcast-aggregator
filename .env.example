# Postgres
POSTGRES_USER=fut
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fut
POSTGRES_PORT=5432

# String de conexão usada pelo app e pelo alembic (dentro da rede docker compose
# o host é o nome do serviço "db"; ajuste se rodar fora do compose).
DATABASE_URL=postgresql+psycopg://fut:troque-esta-senha@db:5432/fut

# User-Agent identificável da fonte futnatv — ver
# app/sources/futnatv/docs/legal-e-etiqueta.md. Troque pelo contato do seu projeto.
FUTNATV_CONTACT_INFO=fut-aggregator/1.0 (uso pessoal; contato: defina-um-email-ou-repo-aqui)

# Roda uma coleta imediatamente ao subir o container, além do agendamento de cada fonte
RUN_ON_STARTUP=true

TZ=America/Sao_Paulo

# --- Notificações de erro (Pushover) ---
# Sem as duas primeiras variáveis o notificador fica inerte: os erros continuam
# indo para o log e para a tabela `scrape_run`, só não viram push. É o que
# permite rodar os testes e o dev local sem configurar nada.
# Crie uma aplicação em https://pushover.net/apps/build para obter o token.
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# Prefixo do título dos pushes — distingue instâncias (prod/staging) que mandem
# para o mesmo celular.
PUSHOVER_APP_NAME=fut
PUSHOVER_TIMEOUT_SECONDS=10

# Segundos de banco inacessível no boot antes de notificar. Abaixo disso, um
# restart rotineiro do Postgres passa despercebido, que é o desejado.
DB_WAIT_NOTIFY_AFTER_SECONDS=60
# Teto de espera pelo banco; 0 = espera indefinidamente (default), que é o que
# mantém o container vivo em vez de entrar em crash loop.
DB_WAIT_MAX_SECONDS=0

# Atraso tolerado antes de um job agendado contar como execução perdida.
MISFIRE_GRACE_SECONDS=300
