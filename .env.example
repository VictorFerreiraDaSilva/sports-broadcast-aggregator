# Postgres
POSTGRES_USER=fut
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fut
POSTGRES_PORT=5432

# String de conexão usada pelo app e pelo alembic (dentro da rede docker compose
# o host é o nome do serviço "db"; ajuste se rodar fora do compose).
DATABASE_URL=postgresql+psycopg://fut:troque-esta-senha@db:5432/fut

# User-Agent identificável da fonte futnatv — ver
# app/sources/futnatv/docs/legal-e-etiqueta.md. Troque pelo contato do seu projeto.
FUTNATV_CONTACT_INFO=fut-aggregator/1.0 (uso pessoal; contato: defina-um-email-ou-repo-aqui)

# Roda uma coleta imediatamente ao subir o container, além do agendamento de cada fonte
RUN_ON_STARTUP=true

TZ=America/Sao_Paulo
