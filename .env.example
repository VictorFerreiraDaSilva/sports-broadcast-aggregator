# Postgres
POSTGRES_USER=fut
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fut
POSTGRES_PORT=5432

# Connection string used by the app and by alembic (inside the docker compose
# network the host is the service name "db"; adjust it if you run outside compose).
DATABASE_URL=postgresql+psycopg://fut:troque-esta-senha@db:5432/fut

# Identifiable User-Agent for the futnatv source — see
# app/sources/futnatv/docs/legal-and-etiquette.md. Replace it with your project's contact.
FUTNATV_CONTACT_INFO=fut-aggregator/1.0 (personal use; contact: set-an-email-or-repo-here)

# Runs a collection right away when the container comes up, on top of each source's schedule
RUN_ON_STARTUP=true

TZ=America/Sao_Paulo

# --- Error notifications (Pushover) ---
# Without the first two variables the notifier stays inert: errors still go to
# the log and to the `scrape_run` table, they just do not become pushes. That is
# what lets the tests and local dev run with nothing configured.
# Create an application at https://pushover.net/apps/build to get the token.
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# Prefix for the push titles — tells apart instances (prod/staging) that push to
# the same phone.
PUSHOVER_APP_NAME=fut
PUSHOVER_TIMEOUT_SECONDS=10

# Seconds of unreachable database at boot before notifying. Below that, a
# routine Postgres restart goes unnoticed, which is what we want.
DB_WAIT_NOTIFY_AFTER_SECONDS=60
# Ceiling on waiting for the database; 0 = wait indefinitely (default), which is
# what keeps the container alive instead of entering a crash loop.
DB_WAIT_MAX_SECONDS=0

# Delay tolerated before a scheduled job counts as a missed run.
MISFIRE_GRACE_SECONDS=300
